# Versão da base de dados OpenCEP
# Veja releases disponíveis em: https://github.com/SeuAliado/OpenCEP/releases
OPENCEP_VERSION=2.0.1

# O Compose detecta automaticamente o DNS interno de Docker ou Podman.
# Defina apenas quando a hospedagem exigir um resolver específico.
# NGINX_DNS_RESOLVER=169.254.169.253

# Habilita BuildKit para cache otimizado (recomendado)
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# Máximo de buscas textuais simultâneas no backend Rust
# SEARCH_CONCURRENCY=16
