# Versão da base de dados OpenCEP
# Veja releases disponíveis em: https://github.com/SeuAliado/OpenCEP/releases
OPENCEP_VERSION=2.0.1

# Docker Compose usa o DNS interno da rede Docker; altere se sua rede usar outro resolver.
# NGINX_DNS_RESOLVER=127.0.0.11

# Habilita BuildKit para cache otimizado (recomendado)
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
